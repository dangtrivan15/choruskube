{
  "mappings": [
    {
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPathPattern": "/repos/[^/]+/missing-repo",
        "headers": {
          "Authorization": { "contains": "token " }
        }
      },
      "response": {
        "status": 404,
        "headers": { "Content-Type": "application/json" },
        "body": "{\"message\":\"Not Found\"}"
      }
    },
    {
      "priority": 2,
      "request": {
        "method": "GET",
        "urlPathPattern": "/repos/[^/]+/missing-repo",
        "headers": {
          "Authorization": { "contains": "Bearer " },
          "User-Agent": { "equalTo": "choruskube-worker" }
        }
      },
      "response": {
        "status": 404,
        "headers": { "Content-Type": "application/json" },
        "body": "{\"message\":\"Not Found\"}"
      }
    },
    {
      "priority": 5,
      "request": {
        "method": "GET",
        "urlPathPattern": "/repos/[^/]+/[^/]+",
        "headers": {
          "Authorization": { "contains": "token " }
        }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "body": "{}"
      }
    },
    {
      "priority": 6,
      "request": {
        "method": "GET",
        "urlPathPattern": "/repos/[^/]+/[^/]+",
        "headers": {
          "Authorization": { "contains": "Bearer " },
          "User-Agent": { "equalTo": "choruskube-worker" }
        }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "body": "{}"
      }
    }
  ]
}
