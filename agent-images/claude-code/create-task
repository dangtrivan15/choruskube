#!/bin/bash
# create-task — create a Task under a Story via the ChorusKube API server.
#
# Usage: create-task --epic-id UUID --story-id UUID --title TITLE --description DESC
#
# Creates a new Task nested under the given Story. A Task is the leaf of the
# Epic -> Story -> Task work hierarchy — it is the only level that can be
# started as a workflow run (via the public API's Start action).
#
# Options:
#   --epic-id UUID          Ancestor Epic UUID (required)
#   --story-id UUID         Parent Story UUID (required)
#   --title TITLE           Task title (required, max 255 chars)
#   --description DESC      Task description (required)
#   -h, --help               Show this help message
#
# Environment:
#   API_SERVER_URL      — Base URL of the ChorusKube API server
#   RUN_ID              — Workflow run UUID
#   NODE_EXECUTION_ID   — Node execution UUID
#   JOB_SECRET          — Bearer token for authentication
#
# Examples:
#   create-task --epic-id <uuid> --story-id <uuid> --title "Add CSV import" --description "..."
#
# Exit codes:
#   0  Task created successfully (JSON response printed to stdout)
#   1  Missing arguments, environment, or API error
set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '2,/^set -euo pipefail$/{ /^set -euo pipefail$/d; s/^# \?//; p }' "$0"
    exit 0
fi

if [ -z "${API_SERVER_URL:-}" ]; then
    echo "ERROR: API_SERVER_URL not set. This script must be run inside an agent pod." >&2
    exit 1
fi

if [ -z "${RUN_ID:-}" ] || [ -z "${NODE_EXECUTION_ID:-}" ]; then
    echo "ERROR: RUN_ID and NODE_EXECUTION_ID must be set." >&2
    exit 1
fi

EPIC_ID=""
STORY_ID=""
TITLE=""
DESCRIPTION=""

while [ $# -gt 0 ]; do
    case "$1" in
        --epic-id)
            EPIC_ID="$2"
            shift 2
            ;;
        --story-id)
            STORY_ID="$2"
            shift 2
            ;;
        --title)
            TITLE="$2"
            shift 2
            ;;
        --description)
            DESCRIPTION="$2"
            shift 2
            ;;
        *)
            echo "ERROR: Unknown argument: $1" >&2
            echo "Usage: create-task --epic-id UUID --story-id UUID --title TITLE --description DESC" >&2
            exit 1
            ;;
    esac
done

if [ -z "$EPIC_ID" ] || [ -z "$STORY_ID" ] || [ -z "$TITLE" ] || [ -z "$DESCRIPTION" ]; then
    echo "ERROR: --epic-id, --story-id, --title and --description are required." >&2
    echo "Usage: create-task --epic-id UUID --story-id UUID --title TITLE --description DESC" >&2
    exit 1
fi

BODY=$(jq -n --arg title "$TITLE" --arg description "$DESCRIPTION" '{title: $title, description: $description}')

RESPONSE=$(curl -s -w "\n%{http_code}" -X POST \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer ${JOB_SECRET:-}" \
    -d "$BODY" \
    "$API_SERVER_URL/internal/runs/$RUN_ID/node-executions/$NODE_EXECUTION_ID/feature-proposals/$EPIC_ID/stories/$STORY_ID/tasks")
HTTP_CODE=$(echo "$RESPONSE" | tail -1)
BODY_RESPONSE=$(echo "$RESPONSE" | sed '$d')

if [ "$HTTP_CODE" != "201" ]; then
    echo "ERROR: Failed to create Task (HTTP $HTTP_CODE): $BODY_RESPONSE" >&2
    exit 1
fi

echo "$BODY_RESPONSE"
