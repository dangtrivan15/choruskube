#!/bin/bash
# record-base — report which default-branch commit each clone sat on.
# Entrypoint-only; not intended for direct agent use.
#
# The approval gate treats a repo with no record as stale, so a failed POST costs one re-check,
# never a wrong merge — which is why this always exits 0.
set -euo pipefail

REPO_BASE_DIR="${REPO_BASE_DIR:-/tmp/choruskube-repo-bases}"
shopt -s nullglob
files=("$REPO_BASE_DIR"/*.json)
[ "${#files[@]}" -gt 0 ] || exit 0
if [ -z "${API_SERVER_URL:-}" ]; then
  echo "WARNING: API_SERVER_URL unset; not recording repo bases" >&2
  exit 0
fi

body=$(jq -s '{repos: .}' "${files[@]}") || { echo "WARNING: unreadable repo base files" >&2; exit 0; }
code=$(curl -s -o /dev/null -w "%{http_code}" -X POST \
  "$API_SERVER_URL/internal/runs/$RUN_ID/node-executions/$NODE_EXECUTION_ID/repo-bases" \
  -H "Authorization: Bearer $JOB_SECRET" \
  -H "Content-Type: application/json" \
  -d "$body") || code=000
if [ "$code" != "204" ]; then
  echo "WARNING: recording repo bases returned HTTP $code; the approval gate will re-check these repos" >&2
fi
exit 0
