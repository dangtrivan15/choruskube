#!/bin/bash
# update-proposal — update an existing roadmap Epic via the ChorusKube API server.
#
# Usage: update-proposal --proposal-id UUID [--title TITLE] [--description DESC] [--motivation MOT] [--milestone-id UUID]
#
# Updates the title, description, motivation, and/or milestone assignment of
# an Epic that has no descendant Task past backlog status. PATCH semantics:
# only fields you pass are changed; omitting a flag leaves the field
# unchanged. Pass --motivation "" to clear the motivation field.
#
# This script keeps its original name, flag names, and internal-endpoint path
# for backward compatibility with deployed agent images (rolling-upgrade
# safety) even though it now operates on Epics, the top level of the
# Epic -> Story -> Task work hierarchy, rather than the old flat
# feature-proposal model. --proposal-id takes the Epic's id.
#
# Options:
#   --proposal-id UUID    Epic UUID to update (required)
#   --title TITLE         New title (optional, max 255 chars)
#   --description DESC    New description (optional)
#   --motivation MOT      New motivation (optional; "" to clear)
#   --milestone-id UUID   Milestone to assign this Epic to (optional). Must
#                         already exist — see create-milestone.
#   -h, --help            Show this help message
#
# Environment:
#   API_SERVER_URL      — Base URL of the ChorusKube API server
#   RUN_ID              — Workflow run UUID
#   NODE_EXECUTION_ID   — Node execution UUID
#   JOB_SECRET          — Bearer token for authentication
#
# Examples:
#   update-proposal --proposal-id <uuid> --title "Refined title"
#   update-proposal --proposal-id <uuid> --description "..." --motivation ""
#   update-proposal --proposal-id <uuid> --milestone-id <uuid>
#
# Exit codes:
#   0  Epic updated successfully (JSON response printed to stdout)
#   1  Missing arguments, environment, or API error
set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '2,/^set -euo pipefail$/{ /^set -euo pipefail$/d; s/^# \?//; p }' "$0"
    exit 0
fi

if [ -z "${API_SERVER_URL:-}" ]; then
    echo "ERROR: API_SERVER_URL not set. This script must be run inside an agent pod." >&2
    exit 1
fi

if [ -z "${RUN_ID:-}" ] || [ -z "${NODE_EXECUTION_ID:-}" ]; then
    echo "ERROR: RUN_ID and NODE_EXECUTION_ID must be set." >&2
    exit 1
fi

PROPOSAL_ID=""
TITLE=""
DESCRIPTION=""
MOTIVATION=""
MILESTONE_ID=""
HAS_TITLE=false
HAS_DESCRIPTION=false
HAS_MOTIVATION=false
HAS_MILESTONE_ID=false

while [ $# -gt 0 ]; do
    case "$1" in
        --proposal-id)
            PROPOSAL_ID="$2"
            shift 2
            ;;
        --title)
            TITLE="$2"
            HAS_TITLE=true
            shift 2
            ;;
        --description)
            DESCRIPTION="$2"
            HAS_DESCRIPTION=true
            shift 2
            ;;
        --motivation)
            MOTIVATION="$2"
            HAS_MOTIVATION=true
            shift 2
            ;;
        --milestone-id)
            MILESTONE_ID="$2"
            HAS_MILESTONE_ID=true
            shift 2
            ;;
        *)
            echo "ERROR: Unknown argument: $1" >&2
            echo "Usage: update-proposal --proposal-id UUID [--title TITLE] [--description DESC] [--motivation MOT] [--milestone-id UUID]" >&2
            exit 1
            ;;
    esac
done

if [ -z "$PROPOSAL_ID" ]; then
    echo "ERROR: --proposal-id is required." >&2
    echo "Usage: update-proposal --proposal-id UUID [--title TITLE] [--description DESC] [--motivation MOT] [--milestone-id UUID]" >&2
    exit 1
fi

if [ "$HAS_TITLE" = false ] && [ "$HAS_DESCRIPTION" = false ] && [ "$HAS_MOTIVATION" = false ] && [ "$HAS_MILESTONE_ID" = false ]; then
    echo "ERROR: At least one of --title, --description, --motivation, or --milestone-id must be provided." >&2
    exit 1
fi

# Build JSON body using jq for proper escaping.
# Only include keys for flags that were explicitly passed (PATCH semantics).
# --milestone-id has no "clear" form here (null means "leave unchanged" on
# this endpoint, not "unassign") — see InternalUpdateEpicRequest's javadoc.
BODY="{}"
if [ "$HAS_TITLE" = true ]; then
    BODY=$(echo "$BODY" | jq --arg v "$TITLE" '. + {title: $v}')
fi
if [ "$HAS_DESCRIPTION" = true ]; then
    BODY=$(echo "$BODY" | jq --arg v "$DESCRIPTION" '. + {description: $v}')
fi
if [ "$HAS_MOTIVATION" = true ]; then
    BODY=$(echo "$BODY" | jq --arg v "$MOTIVATION" '. + {motivation: $v}')
fi
if [ "$HAS_MILESTONE_ID" = true ]; then
    BODY=$(echo "$BODY" | jq --arg v "$MILESTONE_ID" '. + {milestoneId: $v}')
fi

RESPONSE=$(curl -s -w "\n%{http_code}" -X PATCH \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer ${JOB_SECRET:-}" \
    -d "$BODY" \
    "$API_SERVER_URL/internal/runs/$RUN_ID/node-executions/$NODE_EXECUTION_ID/feature-proposals/$PROPOSAL_ID")
HTTP_CODE=$(echo "$RESPONSE" | tail -1)
BODY_RESPONSE=$(echo "$RESPONSE" | sed '$d')

if [ "$HTTP_CODE" != "200" ]; then
    echo "ERROR: Failed to update Epic (HTTP $HTTP_CODE): $BODY_RESPONSE" >&2
    exit 1
fi

echo "$BODY_RESPONSE"
