#!/bin/bash
# create-milestone — create a Milestone via the ChorusKube API server.
#
# Usage: create-milestone --name NAME [--description DESC] [--target-date DATE]
#
# Creates a new Milestone under the current run's software project (Decision 6
# of the roadmap dependencies/priorities/milestones feature) — the
# imperative-agent counterpart to the declarative roadmap_candidates.json
# artifact's "milestones" list. Assign an Epic to the returned Milestone via
# create-proposal --milestone-id or update-proposal --milestone-id.
#
# Options:
#   --name NAME            Milestone name (required, max 255 chars)
#   --description DESC     Milestone description (optional)
#   --target-date DATE     Target date, ISO-8601 (YYYY-MM-DD) (optional)
#   -h, --help              Show this help message
#
# Environment:
#   API_SERVER_URL      — Base URL of the ChorusKube API server
#   RUN_ID              — Workflow run UUID
#   NODE_EXECUTION_ID   — Node execution UUID
#   JOB_SECRET          — Bearer token for authentication
#
# Examples:
#   create-milestone --name "v1.0 Launch"
#   create-milestone --name "v1.0 Launch" --description "First GA release" \
#                    --target-date 2026-12-31
#
# Exit codes:
#   0  Milestone created successfully (JSON response printed to stdout)
#   1  Missing arguments, environment, or API error
set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '2,/^set -euo pipefail$/{ /^set -euo pipefail$/d; s/^# \?//; p }' "$0"
    exit 0
fi

if [ -z "${API_SERVER_URL:-}" ]; then
    echo "ERROR: API_SERVER_URL not set. This script must be run inside an agent pod." >&2
    exit 1
fi

if [ -z "${RUN_ID:-}" ] || [ -z "${NODE_EXECUTION_ID:-}" ]; then
    echo "ERROR: RUN_ID and NODE_EXECUTION_ID must be set." >&2
    exit 1
fi

NAME=""
DESCRIPTION=""
TARGET_DATE=""

while [ $# -gt 0 ]; do
    case "$1" in
        --name)
            NAME="$2"
            shift 2
            ;;
        --description)
            DESCRIPTION="$2"
            shift 2
            ;;
        --target-date)
            TARGET_DATE="$2"
            shift 2
            ;;
        *)
            echo "ERROR: Unknown argument: $1" >&2
            echo "Usage: create-milestone --name NAME [--description DESC] [--target-date DATE]" >&2
            exit 1
            ;;
    esac
done

if [ -z "$NAME" ]; then
    echo "ERROR: --name is required." >&2
    echo "Usage: create-milestone --name NAME [--description DESC] [--target-date DATE]" >&2
    exit 1
fi

# --description and --target-date are spliced in only when set, and sent
# through unvalidated; the server rejects a malformed date with 400, surfaced
# by the non-2xx handling below.
BODY=$(jq -n \
    --arg name "$NAME" \
    --arg description "$DESCRIPTION" \
    --arg targetDate "$TARGET_DATE" \
    '{name: $name}
        + (if $description != "" then {description: $description} else {} end)
        + (if $targetDate != "" then {targetDate: $targetDate} else {} end)')

RESPONSE=$(curl -s -w "\n%{http_code}" -X POST \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer ${JOB_SECRET:-}" \
    -d "$BODY" \
    "$API_SERVER_URL/internal/runs/$RUN_ID/node-executions/$NODE_EXECUTION_ID/milestones")
HTTP_CODE=$(echo "$RESPONSE" | tail -1)
BODY_RESPONSE=$(echo "$RESPONSE" | sed '$d')

if [ "$HTTP_CODE" != "201" ]; then
    echo "ERROR: Failed to create Milestone (HTTP $HTTP_CODE): $BODY_RESPONSE" >&2
    exit 1
fi

echo "$BODY_RESPONSE"
