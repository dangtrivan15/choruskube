#!/bin/bash
# live-chat-loop — interactive chat relay between human and Claude.
# Called via `exec` from entrypoint.sh when mode=live_chat.
#
# Required env vars (exported by entrypoint.sh):
#   SESSION_ID, RUN_ID, NODE_EXECUTION_ID, API_SERVER_URL, JOB_SECRET
#
# Protocol:
#   1. PUT  .../live-chat/session        -> mark session active
#   2. GET  .../live-chat/messages?since= -> poll for user messages
#   3. Run Claude with message, capture response
#   4. POST .../live-chat/messages        -> relay assistant response
#   5. GET  .../live-chat/session         -> check if session closed
#   6. Loop to step 2, or exit if session is completed/failed
set -euo pipefail

BASE_URL="${API_SERVER_URL}/internal/runs/${RUN_ID}/node-executions/${NODE_EXECUTION_ID}/live-chat"
AUTH_HEADER="Authorization: Bearer ${JOB_SECRET}"
POLL_INTERVAL=2
IDLE_TIMEOUT=3600
CLAUDE_SESSION_ID=""
LAST_POLL_TIME=""
LAST_ACTIVITY=$(date +%s)

# --- Helpers ---

api_put() {
  curl -sf -X PUT "$1" \
    -H "Content-Type: application/json" \
    -H "$AUTH_HEADER" \
    -d "$2"
}

api_post() {
  curl -sf -X POST "$1" \
    -H "Content-Type: application/json" \
    -H "$AUTH_HEADER" \
    -d "$2"
}

api_get() {
  curl -sf -X GET "$1" -H "$AUTH_HEADER"
}

# --- Step 1: Mark session active ---
echo "Live chat: marking session $SESSION_ID as active"
api_put "${BASE_URL}/session" '{"status":"active"}' > /dev/null || {
  echo "Live chat: ERROR — failed to mark session active, aborting"
  exit 1
}

# --- Link Claude config (same as entrypoint) ---
if [ -f "/home/agent/.claude/.claude.json" ]; then
  ln -sf /home/agent/.claude/.claude.json /home/agent/.claude.json
fi

# Change to repo directory if available (so Claude has codebase context)
if [ -d "/workspace/repo" ]; then
  cd /workspace/repo
fi

# --- Step 2: Build system prompt for Claude ---
CHAT_SYSTEM_PROMPT="You are a ChorusKube AI assistant in a live chat session with a human reviewer.
The human is reviewing work produced by a previous AI node in the workflow.

The repository has been cloned to /workspace/repo/ and you have read access to the codebase.
Input artifacts from predecessor nodes are available in /workspace/in/.
The run log with context from all prior nodes is at /workspace/in/run_log.md (if it exists).

You can and should use tools to read files, search the codebase, and answer questions about the code.
However, do NOT modify any files — this is a review conversation, not an execution task.
Respond helpfully and concisely."

echo "Live chat: ready, polling for messages..."

# --- Main loop ---
while true; do
  # Poll for new user messages
  if [ -n "$LAST_POLL_TIME" ]; then
    MESSAGES_JSON=$(api_get "${BASE_URL}/messages?since=${LAST_POLL_TIME}" 2>/dev/null || echo "[]")
  else
    MESSAGES_JSON=$(api_get "${BASE_URL}/messages" 2>/dev/null || echo "[]")
  fi

  # Filter to only user messages
  USER_MESSAGES=$(echo "$MESSAGES_JSON" | jq -c '[.[] | select(.role == "user")]' 2>/dev/null) || {
    echo "Live chat: WARNING — could not parse messages JSON: ${MESSAGES_JSON:0:200}"
    USER_MESSAGES="[]"
  }
  MSG_COUNT=$(echo "$USER_MESSAGES" | jq 'length' 2>/dev/null || echo "0")

  if [ "$MSG_COUNT" -gt 0 ]; then
    LAST_ACTIVITY=$(date +%s)

    # Process each user message (process substitution to avoid subshell scope loss)
    while IFS= read -r msg; do
      CONTENT=$(echo "$msg" | jq -r '.content')
      CREATED_AT=$(echo "$msg" | jq -r '.createdAt')
      echo "Live chat: received user message (${#CONTENT} chars)"

      # Run Claude — first message starts session, subsequent resume it
      if [ -z "$CLAUDE_SESSION_ID" ]; then
        CLAUDE_OUTPUT=$(claude -p "$CONTENT" \
          --output-format stream-json \
          --verbose \
          --dangerously-skip-permissions \
          --disallowed-tools "Edit,Write,NotebookEdit,AskUserQuestion" \
          --system-prompt "$CHAT_SYSTEM_PROMPT" \
          2>/tmp/claude_chat_stderr.log || true)
      else
        CLAUDE_OUTPUT=$(claude -p "$CONTENT" \
          --output-format stream-json \
          --verbose \
          --dangerously-skip-permissions \
          --disallowed-tools "Edit,Write,NotebookEdit,AskUserQuestion" \
          --resume "$CLAUDE_SESSION_ID" \
          2>/tmp/claude_chat_stderr.log || true)
      fi

      # Extract session ID and result
      NEW_SESSION_ID=$(echo "$CLAUDE_OUTPUT" | grep '"subtype":"init"' | head -1 | jq -r '.session_id // empty' 2>/dev/null || true)
      if [ -n "$NEW_SESSION_ID" ]; then
        CLAUDE_SESSION_ID="$NEW_SESSION_ID"
      fi

      # Extract the text result
      CLAUDE_RESPONSE=$(echo "$CLAUDE_OUTPUT" | grep '"type":"result"' | tail -1 | jq -r '.result // empty' 2>/dev/null || true)
      if [ -z "$CLAUDE_RESPONSE" ]; then
        # Fallback: extract from last assistant message
        CLAUDE_RESPONSE=$(echo "$CLAUDE_OUTPUT" | grep '"type":"assistant"' | tail -1 | \
          jq -r '[.message.content[]? | select(.type == "text") | .text] | join("\n")' 2>/dev/null || true)
      fi

      if [ -n "$CLAUDE_RESPONSE" ]; then
        echo "Live chat: sending assistant response (${#CLAUDE_RESPONSE} chars)"
        RESPONSE_BODY=$(jq -n --arg role "assistant" --arg content "$CLAUDE_RESPONSE" \
          '{role: $role, content: $content}')
        api_post "${BASE_URL}/messages" "$RESPONSE_BODY" > /dev/null || \
          echo "Live chat: WARNING — failed to relay assistant message"
      else
        echo "Live chat: WARNING — Claude returned empty response"
      fi

      # Update poll timestamp to after this message
      LAST_POLL_TIME="$CREATED_AT"
    done < <(echo "$USER_MESSAGES" | jq -c '.[]')
  fi

  # Check if session is still active (before idle timeout, so clean exits take priority)
  # Note: getActiveSession() returns 404 when session is completed/failed,
  # so we check HTTP status code directly rather than relying on JSON parsing.
  SESSION_RESPONSE=$(curl -s -o /dev/stdout -w "\n%{http_code}" -X GET "${BASE_URL}/session" -H "$AUTH_HEADER" 2>/dev/null || true)
  HTTP_CODE=$(echo "$SESSION_RESPONSE" | tail -1)
  if [ "$HTTP_CODE" = "404" ]; then
    echo "Live chat: session no longer active (404) — exiting"
    break
  fi
  SESSION_STATUS=$(echo "$SESSION_RESPONSE" | sed '$d' | jq -r '.status // "active"' 2>/dev/null || echo "active")
  if [ "$SESSION_STATUS" = "completed" ] || [ "$SESSION_STATUS" = "failed" ]; then
    echo "Live chat: session $SESSION_STATUS — exiting"
    break
  fi

  # Check idle timeout
  NOW=$(date +%s)
  IDLE_SECONDS=$((NOW - LAST_ACTIVITY))
  if [ "$IDLE_SECONDS" -ge "$IDLE_TIMEOUT" ]; then
    echo "Live chat: idle timeout (${IDLE_TIMEOUT}s) — exiting"
    api_put "${BASE_URL}/session" '{"status":"failed"}' > /dev/null 2>&1 || true
    break
  fi

  sleep "$POLL_INTERVAL"
done

echo "Live chat: done"
exit 0
