#!/bin/bash
# list-proposals — list roadmap Epics for the current run's software project.
#
# Usage: list-proposals
#
# Queries the ChorusKube API server for all Epics associated with the software
# project of the current workflow run. Prints a JSON array to stdout.
#
# This script keeps its original name and internal-endpoint path for backward
# compatibility with deployed agent images (rolling-upgrade safety) even though
# it now lists Epics, the top level of the Epic -> Story -> Task work
# hierarchy, rather than the old flat feature-proposal model.
#
# Environment:
#   API_SERVER_URL      — Base URL of the ChorusKube API server
#   RUN_ID              — Workflow run UUID
#   NODE_EXECUTION_ID   — Node execution UUID
#   JOB_SECRET          — Bearer token for authentication
#
# Examples:
#   # Print all Epics as JSON
#   list-proposals
#
#   # Count Epics
#   list-proposals | jq length
#
#   # Get titles only
#   list-proposals | jq '.[].title'
#
# Exit codes:
#   0  Epics listed successfully (JSON array printed to stdout)
#   1  Missing environment or API error
set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '2,/^set -euo pipefail$/{ /^set -euo pipefail$/d; s/^# \?//; p }' "$0"
    exit 0
fi

if [ -z "${API_SERVER_URL:-}" ]; then
    echo "ERROR: API_SERVER_URL not set. This script must be run inside an agent pod." >&2
    exit 1
fi

if [ -z "${RUN_ID:-}" ] || [ -z "${NODE_EXECUTION_ID:-}" ]; then
    echo "ERROR: RUN_ID and NODE_EXECUTION_ID must be set." >&2
    exit 1
fi

RESPONSE=$(curl -s -w "\n%{http_code}" \
    -H "Authorization: Bearer ${JOB_SECRET:-}" \
    "$API_SERVER_URL/internal/runs/$RUN_ID/node-executions/$NODE_EXECUTION_ID/feature-proposals")
HTTP_CODE=$(echo "$RESPONSE" | tail -1)
BODY=$(echo "$RESPONSE" | sed '$d')

if [ "$HTTP_CODE" != "200" ]; then
    echo "ERROR: Failed to list Epics (HTTP $HTTP_CODE): $BODY" >&2
    exit 1
fi

echo "$BODY"
