#!/usr/bin/env bash
set -uo pipefail

# Runs the test suite of every git repo in the run, then aggregates pass/fail.
#
# Layouts handled:
#   * Repo Group (multi-repo): /workspace/config.json has a non-empty `repos[]`,
#     each entry has `name` (and optionally `test_command`); each repo's working
#     copy lives under /workspace/repo/<name>/.
#   * Single Git Repo: `repos[]` is absent; the run-level `test_command` is
#     exposed at the top level of config.json and the working copy lives
#     directly at /workspace/repo/.
#
# Repos with empty/null test_command are skipped (recorded in the report) — a
# Repo Group with no test_commands configured is treated as a pass, matching
# the "no test configured = pass" convention.
#
# When a multi-repo config.json sets `test_affected_only`, a repo's suite runs
# only if this run changed that repo or one it depends on (`depends_on`,
# transitively); every other repo is SKIPPED (unaffected), and a Test scope
# section at the top of the report says why each repo is in or out.
#
# Exit code: 0 if every suite that ran passed (including when none ran), 1
# otherwise. The entrypoint translates the exit code into the node decision
# (passed/failed).

CONFIG=/workspace/config.json
REPORT=/workspace/out/test_report.md
mkdir -p /workspace/out

if [ ! -f "$CONFIG" ]; then
  echo "ERROR: $CONFIG not found" >&2
  exit 1
fi

# tab-separated list of (name, dir, cmd) tuples
PLAN_FILE=$(mktemp)
# Test scope, filled only when the project opts in: one affected name per line; name<TAB>reason;
# name<TAB>dependency.
AFFECTED_FILE=$(mktemp)
REASONS_FILE=$(mktemp)
DEPS_FILE=$(mktemp)
trap 'rm -f "$PLAN_FILE" "$AFFECTED_FILE" "$REASONS_FILE" "$DEPS_FILE"' EXIT

REPOS_LEN=$(jq '(.repos // []) | length' "$CONFIG")

if [ "$REPOS_LEN" -gt 0 ]; then
  # Multi-repo: cd into /workspace/repo/<name> per entry. local_path is set by
  # the orchestrator; fall back to /workspace/repo/<name> for safety.
  jq -r '
    .repos[]
    | [
        .name // "repo",
        (.local_path // ("/workspace/repo/" + (.name // "repo"))),
        (.test_command // "")
      ]
    | @tsv
  ' "$CONFIG" > "$PLAN_FILE"
else
  # Single-repo: derive a display name from repo_url; cd is /workspace/repo.
  TC=$(jq -r '.test_command // ""' "$CONFIG")
  NAME=$(jq -r '.repo_url // "" | split("/") | last | sub("\\.git$"; "")' "$CONFIG")
  [ -z "$NAME" ] && NAME="repo"
  printf '%s\t%s\t%s\n' "$NAME" "/workspace/repo" "$TC" > "$PLAN_FILE"
fi

# Must name the branch entrypoint.sh's rebase_onto_default rebased the run onto: against any
# other base, the commits ahead of it are no longer this run's commits.
default_branch_of() {
    local branch
    branch=$(git -C "$1" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)
    branch="${branch#origin/}"
    [ -n "$branch" ] || branch=main
    printf '%s' "$branch"
}

# Exit 0 when DIR holds work its default branch lacks: commits, tracked edits, or untracked
# non-ignored files. Whatever git cannot answer counts as changed: skipping a suite that
# should have run is the one wrong answer here.
repo_changed() {
    local dir="$1" base ahead status
    base="refs/remotes/origin/$(default_branch_of "$dir")"
    git -C "$dir" rev-parse --verify --quiet "$base^{commit}" > /dev/null 2>&1 || return 0
    ahead=$(git -C "$dir" rev-list --count "$base..HEAD" 2>/dev/null) || return 0
    case "$ahead" in ''|*[!0-9]*) return 0 ;; esac
    [ "$ahead" -eq 0 ] || return 0
    status=$(git -C "$dir" status --porcelain --untracked-files=normal 2>/dev/null) || return 0
    [ -n "$status" ]
}

is_affected() {
    grep -qxF -- "$1" "$AFFECTED_FILE"
}

# Runs before any suite, so a file one suite writes into a sibling repo cannot pull that
# sibling in. Every pass that adds nothing ends the loop and every other one marks a new
# repo, so REPOS_LEN passes bound it even when depends_on has a cycle.
compute_affected() {
    local name dir cmd dep added pass=0
    while IFS=$'\t' read -r name dir cmd; do
        if repo_changed "$dir" < /dev/null; then
            printf '%s\n' "$name" >> "$AFFECTED_FILE"
            printf '%s\tchanged\n' "$name" >> "$REASONS_FILE"
        fi
    done < "$PLAN_FILE"
    jq -r '.repos[] | (.name // "repo") as $n
           | (.depends_on // []) | if type == "array" then .[] else empty end
           | select(type == "string" and length > 0) | [$n, .] | @tsv' "$CONFIG" > "$DEPS_FILE"
    while [ "$pass" -lt "$REPOS_LEN" ]; do
        added=0
        while IFS=$'\t' read -r name dep; do
            is_affected "$name" && continue
            if is_affected "$dep"; then
                printf '%s\n' "$name" >> "$AFFECTED_FILE"
                printf '%s\tdepends on %s\n' "$name" "$dep" >> "$REASONS_FILE"
                added=1
            fi
        done < "$DEPS_FILE"
        [ "$added" -eq 1 ] || break
        pass=$((pass + 1))
    done
}

# A depends_on name that is no repo in this run can never be marked, so it is ignored — but
# silently ignoring it would hide a dependent that should have run.
unknown_dependency_warnings() {
    local name dep
    while IFS=$'\t' read -r name dep; do
        awk -F'\t' -v d="$dep" '$1 == d {found = 1} END {exit !found}' "$PLAN_FILE" && continue
        printf -- "- Warning: \`%s\` depends on \`%s\`, which is not a repo in this run; ignored.\n" "$name" "$dep"
    done < "$DEPS_FILE"
}

write_test_scope() {
    local name dir cmd reason changed warnings
    changed=$(awk -F'\t' '$2 == "changed" {printf "%s`%s`", sep, $1; sep = ", "}' "$REASONS_FILE")
    echo "## Test scope"
    echo ""
    echo "Test only affected repos is on: a repo's suite runs only if this run changed it or a repo it depends on."
    echo ""
    echo "**Changed:** ${changed:-none}"
    echo ""
    while IFS=$'\t' read -r name dir cmd; do
        reason=$(awk -F'\t' -v n="$name" '$1 == n {print $2; exit}' "$REASONS_FILE")
        if [ -n "$reason" ]; then
            echo "- \`$name\`: affected ($reason)"
        else
            echo "- \`$name\`: unaffected"
        fi
    done < "$PLAN_FILE"
    warnings=$(unknown_dependency_warnings)
    if [ -n "$warnings" ]; then
        echo ""
        printf '%s\n' "$warnings"
    fi
    echo ""
}

SCOPED=0
if [ "$REPOS_LEN" -gt 0 ] && [ "$(jq -r '.test_affected_only == true' "$CONFIG")" = "true" ]; then
  SCOPED=1
  compute_affected
fi

OVERALL_EXIT=0
HAS_RUNNABLE=0
UNAFFECTED_SKIPS=0

# Where a repo's reports live. The seeders put `-Dtest.reports.dir=<abs path>` in the
# test_command (a per-repo report ROOT — see the repo build files), so parse it back out
# rather than assuming a path: a repo whose command sets a different root still gets its
# reports found. Falls back to the conventional location, which is also what a repo that
# does not pass the flag at all would use if it ever started to.
#
# `;`, `&`, `|` are excluded from the value alongside whitespace: a user-authored
# test_command can chain a further command directly onto the flag with no separating space
# (`...=/x/y;exit 1`, `...=/x/y&&echo ok`), and without excluding them the match runs on
# past the path into that next command, producing a bogus root.
reports_root_for() {
    local cmd="$1" name="$2" root
    root=$(printf '%s' "$cmd" \
        | grep -oE '\-Dtest\.reports\.dir=[^[:space:];&|]+' \
        | head -1 | cut -d= -f2-)
    [ -n "$root" ] || root="/workspace/out/reports/$name"
    printf '%s' "$root"
}

# harvest-junit.js sits beside this script (/usr/local/bin in the image); resolve it
# relative to $0 so the test harness's rewritten copy finds its own sibling.
HARVEST_JUNIT="$(dirname "$0")/harvest-junit.js"

# Never fails: a missing harvester, a missing node, or an absent report tree yields an
# empty section rather than a failed Test node. A report file that exists inside the tree
# but can't be read or parsed is different — harvest-junit.js counts and notes those rather
# than silently reading them as "no failures" (see its own comments).
harvest_failures() {
    local root="$1"
    [ -d "$root" ] || return 0
    [ -f "$HARVEST_JUNIT" ] || return 0
    command -v node > /dev/null 2>&1 || return 0
    node "$HARVEST_JUNIT" "$root" 2>/dev/null || true
}

# Playwright's JSON reporter, when the config emits one. jq rather than the Node
# harvester because this is already JSON — and an absent file is the expected state on
# any repo whose config has not been updated, so it must be silent, not a warning.
harvest_playwright() {
    local json="$1/playwright/results.json"
    [ -f "$json" ] || return 0
    jq -r '
      def specs: .. | objects | select(has("specs")) | .specs[];
      [ specs | select(.ok == false) ] as $failed
      | if ($failed | length) == 0 then empty
        else
          "#### playwright — \($failed | length) failing", "",
          ( $failed[]
            | "- **\(.title)**",
              ( [ .tests[]?.results[]? | select(.status != "passed") | .error?.message? // empty ]
                | first // empty
                | "  - " + (. | gsub("\\s*\n\\s*"; " "))
              )
          ),
          ""
        end
    ' "$json" 2>/dev/null || true
}

ARCHIVE_NOTES=""

# The run's object-storage prefix, so the index can print a copy-pasteable `artifact get`
# rather than a template. entrypoint.sh reads the same field into its own OUTPUT_PATH but
# never exports it, so this script — a child process — has to read config.json itself.
OUTPUT_PATH=$(jq -r '.output_path // ""' "$CONFIG")

# One tarball per component directory, then delete the originals. The delete is the
# point: entrypoint.sh uploads /workspace/out with `find . -type f` and one presign+PUT
# per file, so leaving the tree in place would keep every one of the ~2000 report files
# in the upload loop and in the run's artifact list.
#
# Loose files at the report root (timings.tsv/txt, test-output.log) are deliberately not
# archived — they are small, high-signal, and worth reading without unpacking anything.
#
# A tar failure is never fatal. This is reporting, and turning a passing suite red over a
# packaging problem would be strictly worse than uploading that component unarchived.
archive_components() {
    local root="$1" d comp err
    [ -d "$root" ] || return 0
    err=$(mktemp)
    for d in "$root"/*/; do
        [ -d "$d" ] || continue
        comp=$(basename "$d")
        if tar -czf "$root/$comp.tar.gz" -C "$root" "$comp" 2> "$err"; then
            # ${d%/} strips the glob's trailing slash: rm -rf on a symlinked component
            # dir with the slash kept would follow the link and delete its target — which
            # can be anywhere on disk — while leaving the symlink itself in place.
            rm -rf "${d%/}"
            printf '| `%s.tar.gz` | %s |\n' "$comp" "$(du -h "$root/$comp.tar.gz" | cut -f1)"
        else
            rm -f "$root/$comp.tar.gz"
            ARCHIVE_NOTES="${ARCHIVE_NOTES}- \`${comp}\`: archiving failed ($(head -1 "$err")); files left in place
"
        fi
    done
    rm -f "$err"
}

{
  echo "# Test Report"
  echo ""
} > "$REPORT"
if [ "$SCOPED" -eq 1 ]; then
  write_test_scope >> "$REPORT"
fi

while IFS=$'\t' read -r NAME DIR CMD; do
  if [ -z "$CMD" ] || [ "$CMD" = "null" ]; then
    {
      echo "## $NAME"
      echo ""
      echo "**Status:** SKIPPED (no test_command configured)"
      echo ""
    } >> "$REPORT"
    continue
  fi

  if [ "$SCOPED" -eq 1 ] && ! is_affected "$NAME"; then
    echo "==> $NAME: skipped (unaffected)"
    {
      echo "## $NAME"
      echo ""
      echo "**Status:** SKIPPED (unaffected — no change in this repo or any repo it depends on)"
      echo ""
    } >> "$REPORT"
    UNAFFECTED_SKIPS=$((UNAFFECTED_SKIPS + 1))
    continue
  fi

  if [ ! -d "$DIR" ]; then
    {
      echo "## $NAME"
      echo ""
      echo "**Status:** FAILED (working directory not found: \`$DIR\`)"
      echo ""
    } >> "$REPORT"
    OVERALL_EXIT=1
    HAS_RUNNABLE=1
    continue
  fi

  HAS_RUNNABLE=1
  echo "==> $NAME: cd $DIR && $CMD"
  pushd "$DIR" > /dev/null
  set +e
  OUTPUT=$(eval "$CMD" 2>&1)
  EXIT=$?
  set -e
  popd > /dev/null

  if [ "$EXIT" -eq 0 ]; then
    STATUS="PASSED"
  else
    STATUS="FAILED (exit $EXIT)"
    OVERALL_EXIT=1
  fi

  REPORTS_ROOT=$(reports_root_for "$CMD" "$NAME")

  # Full output, not a tail. The failing test names in a multi-module Gradle run scroll
  # past long before the last 100 lines, which is why the old `tail -100` summary could
  # say a run failed without saying what failed. Lands inside the report tree when there
  # is one so it is archived alongside its component reports; otherwise beside them.
  if [ -d "$REPORTS_ROOT" ]; then
    OUTPUT_LOG="$REPORTS_ROOT/test-output.log"
  else
    OUTPUT_LOG="/workspace/out/${NAME}-test-output.log"
  fi
  # `-e` is active here (the header omits it, but the eval capture above turns it back on
  # for the rest of the loop body — see the comment at the top of the loop). Reporting must
  # never change the node's verdict, so an unwritable/full /workspace/out must not abort the
  # loop iteration the way an unguarded failure here would.
  mkdir -p "$(dirname "$OUTPUT_LOG")" || true
  printf '%s\n' "$OUTPUT" > "$OUTPUT_LOG" || true

  FAILING_SECTION=$(printf '%s\n%s' \
      "$(harvest_failures "$REPORTS_ROOT")" \
      "$(harvest_playwright "$REPORTS_ROOT")")
  # Collapse to empty when both harvesters produced nothing, so the index omits the
  # heading entirely rather than printing an empty "Failing tests" section.
  [ -n "$(printf '%s' "$FAILING_SECTION" | tr -d '[:space:]')" ] || FAILING_SECTION=""

  # Must run after both harvesters above: they read files inside REPORTS_ROOT that
  # archiving deletes.
  #
  # Reset per repo: ARCHIVE_NOTES is a global archive_components appends to, so without
  # this a note from one repo's failure would still be sitting there — and get printed
  # again — under every later repo's report section, including ones that archived cleanly.
  ARCHIVE_NOTES=""

  # Captured via a redirect rather than `ARCHIVE_ROWS=$(archive_components ...)`: command
  # substitution forks a subshell, and archive_components's writes to the global
  # ARCHIVE_NOTES would be lost with it, silently dropping every archiving-failure note.
  ARCHIVE_ROWS_FILE=$(mktemp)
  archive_components "$REPORTS_ROOT" > "$ARCHIVE_ROWS_FILE"
  ARCHIVE_ROWS=$(cat "$ARCHIVE_ROWS_FILE")
  rm -f "$ARCHIVE_ROWS_FILE"

  {
    echo "## $NAME"
    echo ""
    echo "**Directory:** \`$DIR\`"
    echo "**Command:** \`$CMD\`"
    echo "**Status:** $STATUS"
    echo ""
    if [ -n "$FAILING_SECTION" ]; then
      echo "### Failing tests"
      echo ""
      printf '%s\n' "$FAILING_SECTION"
    fi
    # $( ) above stripped the harvesters' own trailing blank line, so without this the
    # section ends on the last content line (often a "  - message" bullet) and "Full
    # output:" renders as a lazy continuation inside it rather than its own paragraph.
    echo ""
    echo "Full output: \`${OUTPUT_LOG#/workspace/out/}\`"
    echo ""
    echo "<details><summary>Last 100 lines of output</summary>"
    echo ""
    echo '```'
    printf '%s\n' "$OUTPUT" | tail -100
    echo '```'
    echo ""
    echo "</details>"
    echo ""
    if [ -n "$ARCHIVE_ROWS" ]; then
      echo "### Archived reports"
      echo ""
      echo "| Archive | Size |"
      echo "|---|---|"
      printf '%s\n' "$ARCHIVE_ROWS"
      echo ""
      echo "Extract one with:"
      echo ""
      echo '```bash'
      echo "artifact get ${OUTPUT_PATH}${REPORTS_ROOT#/workspace/out/}/<name>.tar.gz /tmp/r.tar.gz"
      echo "mkdir -p /tmp/r && tar -xzf /tmp/r.tar.gz -C /tmp/r"
      echo '```'
      echo ""
    fi
    if [ -n "$ARCHIVE_NOTES" ]; then
      echo "**Archiving notes:**"
      echo ""
      printf '%s\n' "$ARCHIVE_NOTES"
    fi
  } >> "$REPORT"
done < "$PLAN_FILE"

if [ "$HAS_RUNNABLE" -eq 0 ] && [ "$UNAFFECTED_SKIPS" -gt 0 ]; then
  echo "No repo with a test_command is affected by this run — nothing to run."
  echo ""
  echo "_No repo with a test_command is affected by this run — nothing ran; treating as passed._" >> "$REPORT"
elif [ "$HAS_RUNNABLE" -eq 0 ]; then
  echo "No test_command configured for any repo — nothing to run."
  echo ""
  echo "_No test_command configured for any repo — treating as passed._" >> "$REPORT"
fi

if [ "$OVERALL_EXIT" -eq 0 ] && [ "$UNAFFECTED_SKIPS" -gt 0 ]; then
  echo "Every suite that ran passed; $UNAFFECTED_SKIPS unaffected repo(s) skipped."
elif [ "$OVERALL_EXIT" -eq 0 ]; then
  echo "All tests passed."
else
  echo "One or more repos failed tests; see $REPORT for details." >&2
fi

exit "$OVERALL_EXIT"
