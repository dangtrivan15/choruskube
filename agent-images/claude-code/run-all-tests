#!/usr/bin/env bash
set -uo pipefail

# Runs the test suite of every git repo in the run, then aggregates pass/fail.
#
# Layouts handled:
#   * Repo Group (multi-repo): /workspace/config.json has a non-empty `repos[]`,
#     each entry has `name` (and optionally `test_command`); each repo's working
#     copy lives under /workspace/repo/<name>/.
#   * Single Git Repo: `repos[]` is absent; the run-level `test_command` is
#     exposed at the top level of config.json and the working copy lives
#     directly at /workspace/repo/.
#
# Repos with empty/null test_command are skipped (recorded in the report) — a
# Repo Group with no test_commands configured is treated as a pass, matching
# the "no test configured = pass" convention.
#
# Exit code: 0 if every repo with a test_command passed, 1 otherwise. The
# entrypoint translates the exit code into the node decision (passed/failed).

CONFIG=/workspace/config.json
REPORT=/workspace/out/test_report.md
mkdir -p /workspace/out

if [ ! -f "$CONFIG" ]; then
  echo "ERROR: $CONFIG not found" >&2
  exit 1
fi

# tab-separated list of (name, dir, cmd) tuples
PLAN_FILE=$(mktemp)
trap 'rm -f "$PLAN_FILE"' EXIT

REPOS_LEN=$(jq '(.repos // []) | length' "$CONFIG")

if [ "$REPOS_LEN" -gt 0 ]; then
  # Multi-repo: cd into /workspace/repo/<name> per entry. local_path is set by
  # the orchestrator; fall back to /workspace/repo/<name> for safety.
  jq -r '
    .repos[]
    | [
        .name // "repo",
        (.local_path // ("/workspace/repo/" + (.name // "repo"))),
        (.test_command // "")
      ]
    | @tsv
  ' "$CONFIG" > "$PLAN_FILE"
else
  # Single-repo: derive a display name from repo_url; cd is /workspace/repo.
  TC=$(jq -r '.test_command // ""' "$CONFIG")
  NAME=$(jq -r '.repo_url // "" | split("/") | last | sub("\\.git$"; "")' "$CONFIG")
  [ -z "$NAME" ] && NAME="repo"
  printf '%s\t%s\t%s\n' "$NAME" "/workspace/repo" "$TC" > "$PLAN_FILE"
fi

OVERALL_EXIT=0
HAS_RUNNABLE=0

# Where a repo's reports live. The seeders put `-Dtest.reports.dir=<abs path>` in the
# test_command (a per-repo report ROOT — see the repo build files), so parse it back out
# rather than assuming a path: a repo whose command sets a different root still gets its
# reports found. Falls back to the conventional location, which is also what a repo that
# does not pass the flag at all would use if it ever started to.
reports_root_for() {
    local cmd="$1" name="$2" root
    root=$(printf '%s' "$cmd" \
        | grep -oE '\-Dtest\.reports\.dir=[^[:space:]]+' \
        | head -1 | cut -d= -f2-)
    [ -n "$root" ] || root="/workspace/out/reports/$name"
    printf '%s' "$root"
}

# harvest-junit.js sits beside this script (/usr/local/bin in the image); resolve it
# relative to $0 so the test harness's rewritten copy finds its own sibling.
HARVEST_JUNIT="$(dirname "$0")/harvest-junit.js"

# Never fails: a missing harvester, a missing node, or an unparseable tree yields an
# empty section rather than a failed Test node.
harvest_failures() {
    local root="$1"
    [ -d "$root" ] || return 0
    [ -f "$HARVEST_JUNIT" ] || return 0
    command -v node > /dev/null 2>&1 || return 0
    node "$HARVEST_JUNIT" "$root" 2>/dev/null || true
}

# Playwright's JSON reporter, when the config emits one. jq rather than the Node
# harvester because this is already JSON — and an absent file is the expected state on
# any repo whose config has not been updated, so it must be silent, not a warning.
harvest_playwright() {
    local root="$1" json="$1/playwright/results.json"
    [ -f "$json" ] || return 0
    jq -r '
      def specs: .. | objects | select(has("specs")) | .specs[];
      [ specs | select(.ok == false) ] as $failed
      | if ($failed | length) == 0 then empty
        else
          "#### playwright — \($failed | length) failing", "",
          ( $failed[]
            | "- **\(.title)**",
              ( [ .tests[]?.results[]? | select(.status != "passed") | .error?.message? // empty ]
                | first // empty
                | "  - " + (. | gsub("\\s*\n\\s*"; " "))
              )
          ),
          ""
        end
    ' "$json" 2>/dev/null || true
}

{
  echo "# Test Report"
  echo ""
} > "$REPORT"

while IFS=$'\t' read -r NAME DIR CMD; do
  if [ -z "$CMD" ] || [ "$CMD" = "null" ]; then
    {
      echo "## $NAME"
      echo ""
      echo "**Status:** SKIPPED (no test_command configured)"
      echo ""
    } >> "$REPORT"
    continue
  fi

  if [ ! -d "$DIR" ]; then
    {
      echo "## $NAME"
      echo ""
      echo "**Status:** FAILED (working directory not found: \`$DIR\`)"
      echo ""
    } >> "$REPORT"
    OVERALL_EXIT=1
    HAS_RUNNABLE=1
    continue
  fi

  HAS_RUNNABLE=1
  echo "==> $NAME: cd $DIR && $CMD"
  pushd "$DIR" > /dev/null
  set +e
  OUTPUT=$(eval "$CMD" 2>&1)
  EXIT=$?
  set -e
  popd > /dev/null

  if [ "$EXIT" -eq 0 ]; then
    STATUS="PASSED"
  else
    STATUS="FAILED (exit $EXIT)"
    OVERALL_EXIT=1
  fi

  REPORTS_ROOT=$(reports_root_for "$CMD" "$NAME")

  # Full output, not a tail. The failing test names in a multi-module Gradle run scroll
  # past long before the last 100 lines, which is why the old `tail -100` summary could
  # say a run failed without saying what failed. Lands inside the report tree when there
  # is one so it is archived alongside its component reports; otherwise beside them.
  if [ -d "$REPORTS_ROOT" ]; then
    OUTPUT_LOG="$REPORTS_ROOT/test-output.log"
  else
    OUTPUT_LOG="/workspace/out/${NAME}-test-output.log"
  fi
  mkdir -p "$(dirname "$OUTPUT_LOG")"
  printf '%s\n' "$OUTPUT" > "$OUTPUT_LOG"

  FAILING_SECTION=$(printf '%s\n%s' \
      "$(harvest_failures "$REPORTS_ROOT")" \
      "$(harvest_playwright "$REPORTS_ROOT")")
  # Collapse to empty when both harvesters produced nothing, so the index omits the
  # heading entirely rather than printing an empty "Failing tests" section.
  [ -n "$(printf '%s' "$FAILING_SECTION" | tr -d '[:space:]')" ] || FAILING_SECTION=""

  {
    echo "## $NAME"
    echo ""
    echo "**Directory:** \`$DIR\`"
    echo "**Command:** \`$CMD\`"
    echo "**Status:** $STATUS"
    echo ""
    if [ -n "$FAILING_SECTION" ]; then
      echo "### Failing tests"
      echo ""
      printf '%s\n' "$FAILING_SECTION"
    fi
    echo "Full output: \`${OUTPUT_LOG#/workspace/out/}\`"
    echo ""
    echo "<details><summary>Last 100 lines of output</summary>"
    echo ""
    echo '```'
    printf '%s\n' "$OUTPUT" | tail -100
    echo '```'
    echo ""
    echo "</details>"
    echo ""
  } >> "$REPORT"
done < "$PLAN_FILE"

if [ "$HAS_RUNNABLE" -eq 0 ]; then
  echo "No test_command configured for any repo — nothing to run."
  echo ""
  echo "_No test_command configured for any repo — treating as passed._" >> "$REPORT"
fi

if [ "$OVERALL_EXIT" -eq 0 ]; then
  echo "All tests passed."
else
  echo "One or more repos failed tests; see $REPORT for details." >&2
fi

exit "$OVERALL_EXIT"
