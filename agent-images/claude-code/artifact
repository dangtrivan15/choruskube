#!/bin/bash
# artifact — download or upload artifacts via presigned URLs, retrying
# transient failures and telling a missing object apart from every other
# failure.
#
# Usage:
#   artifact get <object-path> <local-path>   # download from object storage
#   artifact put <local-path> <object-path>   # upload to object storage
#
# A put measures the local file's exact byte count and declares it on the
# presign request; the api-server signs that length into the URL, books it
# against the run's upload budget, and the store then refuses any other
# body length. A presign answer of 400 (missing/invalid size), 409 (the run
# is closed) or 413 (past the run's budget) fails the upload at once, with
# no retry and no transfer attempt, and prints the server's error message.
#
# Environment:
#   API_SERVER_URL      — Base URL of the ChorusKube API server
#   RUN_ID              — Workflow run UUID
#   NODE_EXECUTION_ID   — Node execution UUID
#   JOB_SECRET          — Bearer token for authentication
#
# Examples:
#   artifact get runs/abc/node1/out/result.md /workspace/in/result.md
#   artifact put /workspace/out/output.md runs/abc/node2/out/output.md
#
# Exit codes:
#   0  Operation completed successfully
#   4  The object store answered 404 ("no such object") to a GET — the only
#      way this status is produced
#   1  Everything else: missing/invalid environment or arguments, an
#      unreadable local file on a put, a refused presign (400/409/413
#      included), a transfer that still fails after its retries (a 403, a
#      PUT's 404, an unresolvable host, a persistent 5xx), or any inner
#      command's own failure
#
# Retries (the presign call and the transfer, independently): a connection
# failure, a timeout, HTTP 408, HTTP 429 or any HTTP 5xx. Up to 5 attempts
# total, backing off 2s/4s/8s/16s between them. A transfer never starts an
# attempt more than 120s after its URL was issued, and a backoff that would
# cross that deadline ends it as a failure instead of sleeping past it.
# Everything else (a 403, a 404 on a PUT, a malformed response) fails on the
# first attempt, with no retry.
#
# Nothing here ever prints a signed URL or a transfer's response body — an
# S3 error body can echo the request signature back.
set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '2,/^set -euo pipefail$/{ /^set -euo pipefail$/d; s/^# \?//; p }' "$0"
    exit 0
fi

EXIT_NOT_FOUND=4
# Set only immediately before the one intentional `exit $EXIT_NOT_FOUND` below,
# so the EXIT trap can tell that apart from an unrelated inner command (jq,
# mkdir, curl) that happens to leak the same number under `set -e` — otherwise
# such a leak would masquerade as "object not found" instead of a real failure.
INTENTIONAL_EXIT=""
trap '
  rc=$?
  if [ "$rc" -eq 0 ]; then
    exit 0
  elif [ -n "$INTENTIONAL_EXIT" ] && [ "$rc" -eq "$INTENTIONAL_EXIT" ]; then
    exit "$rc"
  else
    exit 1
  fi
' EXIT

RETRY_DELAYS=(2 4 8 16)
MAX_ATTEMPTS=5

# --- Validate args ---
ACTION="${1:-}"
if [ "$ACTION" != "get" ] && [ "$ACTION" != "put" ]; then
    echo "Usage: artifact get <object-path> <local-path>" >&2
    echo "       artifact put <local-path> <object-path>" >&2
    exit 1
fi

if [ -z "${2:-}" ] || [ -z "${3:-}" ]; then
    echo "ERROR: Two arguments required after '$ACTION'." >&2
    exit 1
fi

# --- Validate env ---
if [ -z "${API_SERVER_URL:-}" ]; then
    echo "ERROR: API_SERVER_URL not set. This script must be run inside an agent pod." >&2
    exit 1
fi
if [ -z "${RUN_ID:-}" ] || [ -z "${NODE_EXECUTION_ID:-}" ]; then
    echo "ERROR: RUN_ID and NODE_EXECUTION_ID must be set." >&2
    exit 1
fi
if [ -z "${JOB_SECRET:-}" ]; then
    echo "ERROR: JOB_SECRET not set." >&2
    exit 1
fi

# --- Resolve args based on action ---
if [ "$ACTION" = "get" ]; then
    MINIO_PATH="$2"
    LOCAL_PATH="$3"
    METHOD="GET"
    DECLARED_SIZE=""
else
    LOCAL_PATH="$2"
    MINIO_PATH="$3"
    METHOD="PUT"
    # Measured before presigning, never after: the api-server books and signs this exact byte
    # count, so an unreadable file must fail here rather than reach the presign request at all.
    DECLARED_SIZE=$(wc -c < "$LOCAL_PATH") || {
        echo "ERROR: cannot read local file: $LOCAL_PATH" >&2
        exit 1
    }
fi

# --- Shared retry classification, for both the presign call and the transfer ---

# curl exit codes for resolve/connect/partial-body/timeout/TLS-connect/
# empty-reply/send/recv/HTTP-2-stream-reset failures: the ones a retry might
# actually fix. 18 and 92 are a connection a proxy dropped mid-transfer.
is_retryable_curl_rc() {
  case "$1" in
    6 | 7 | 18 | 28 | 35 | 52 | 55 | 56 | 92) return 0 ;;
    *) return 1 ;;
  esac
}

is_retryable_http_status() {
  case "$1" in
    408 | 429 | 5??) return 0 ;;
    *) return 1 ;;
  esac
}

# Names the method, the object path, the attempt, and the HTTP status or curl
# exit code behind it. Never the signed URL or a response body.
log_diag() {
  echo "artifact: $1 $2 (attempt $3/$MAX_ATTEMPTS): $4" >&2
}

# Goes through the external `sleep` binary (bash has no builtin of that name),
# so a test can shim it on PATH and assert the recorded delays without waiting.
backoff() {
  sleep "$1"
}

# Sleeps for the backoff after a transfer attempt, unless doing so would push
# the next attempt past $2 (the transfer deadline) — in which case this fails
# instead of retrying past the presigned URL's validity window.
backoff_or_give_up() {
  local attempt="$1" deadline="$2"
  local delay="${RETRY_DELAYS[$((attempt - 1))]}"
  local now=$(date +%s)
  if [ $((now + delay)) -gt "$deadline" ]; then
    echo "ERROR: next retry would start past the presigned URL's validity window; failing" >&2
    return 1
  fi
  backoff "$delay"
}

# --- Presign call, retried ---
# $1=method $2=object path $3=declared size (PUT only; empty for GET). Prints
# the presign response body on success; a 200 body is never printed anywhere
# else, only returned here for the caller to parse — it carries the signed URL.
do_presign() {
  local method="$1" path="$2" size="${3:-}" attempt=1
  local url="$API_SERVER_URL/internal/runs/$RUN_ID/node-executions/$NODE_EXECUTION_ID/presign?path=$(printf '%s' "$path" | jq -sRr @uri)&method=$method"
  if [ -n "$size" ]; then
    url="${url}&size=${size}"
  fi
  while :; do
    local response http_code body curl_rc
    set +e
    response=$(curl -s --connect-timeout 10 --speed-limit 1 --speed-time 60 \
      -w '\n%{http_code}' \
      -H "Authorization: Bearer $JOB_SECRET" \
      "$url" 2>/dev/null)
    curl_rc=$?
    set -e

    if [ "$curl_rc" -ne 0 ]; then
      log_diag "PRESIGN $method" "$path" "$attempt" "curl exit $curl_rc"
      if [ "$attempt" -lt "$MAX_ATTEMPTS" ] && is_retryable_curl_rc "$curl_rc"; then
        backoff "${RETRY_DELAYS[$((attempt - 1))]}"
        attempt=$((attempt + 1))
        continue
      fi
      echo "ERROR: presign request failed after $attempt attempt(s) (curl exit $curl_rc)" >&2
      exit 1
    fi

    http_code=$(tail -n 1 <<< "$response")
    body=$(sed '$d' <<< "$response")
    if [ "$http_code" = "200" ]; then
      printf '%s' "$body"
      return 0
    fi

    log_diag "PRESIGN $method" "$path" "$attempt" "HTTP $http_code"
    if [ "$attempt" -lt "$MAX_ATTEMPTS" ] && is_retryable_http_status "$http_code"; then
      backoff "${RETRY_DELAYS[$((attempt - 1))]}"
      attempt=$((attempt + 1))
      continue
    fi
    echo "ERROR: presign request failed (HTTP $http_code): $body" >&2
    exit 1
  done
}

# --- Transfer, retried within the presigned URL's validity window ---
# $1=method $2=signed url $3=local path $4=object path (diagnostics only)
# $5=deadline (epoch seconds, from when the URL was issued).
do_transfer() {
  local method="$1" url="$2" local_path="$3" obj_path="$4" deadline="$5"
  local attempt=1
  local part_path="${local_path}.part"

  while :; do
    local now=$(date +%s)
    if [ "$now" -ge "$deadline" ]; then
      echo "ERROR: the presigned URL's validity window elapsed before attempt $attempt" >&2
      exit 1
    fi

    local http_code curl_rc
    set +e
    if [ "$method" = "GET" ]; then
      mkdir -p "$(dirname "$local_path")"
      http_code=$(curl -s -L -o "$part_path" -w '%{http_code}' \
        --connect-timeout 10 --speed-limit 1 --speed-time 60 \
        "$url" 2>/dev/null)
    else
      http_code=$(curl -s -L -o /dev/null -w '%{http_code}' \
        --connect-timeout 10 --speed-limit 1 --speed-time 60 \
        -T "$local_path" \
        "$url" 2>/dev/null)
    fi
    curl_rc=$?
    set -e

    if [ "$curl_rc" -ne 0 ]; then
      rm -f "$part_path"
      log_diag "$method" "$obj_path" "$attempt" "curl exit $curl_rc"
      if [ "$attempt" -lt "$MAX_ATTEMPTS" ] && is_retryable_curl_rc "$curl_rc" \
        && backoff_or_give_up "$attempt" "$deadline"; then
        attempt=$((attempt + 1))
        continue
      fi
      echo "ERROR: transfer failed after $attempt attempt(s) (curl exit $curl_rc)" >&2
      exit 1
    fi

    case "$http_code" in
      2??)
        if [ "$method" = "GET" ]; then
          mv "$part_path" "$local_path"
        fi
        return 0
        ;;
      404)
        rm -f "$part_path"
        log_diag "$method" "$obj_path" "$attempt" "HTTP 404"
        if [ "$method" = "GET" ]; then
          INTENTIONAL_EXIT=$EXIT_NOT_FOUND
          exit $EXIT_NOT_FOUND
        fi
        echo "ERROR: transfer failed (HTTP 404)" >&2
        exit 1
        ;;
      *)
        rm -f "$part_path"
        log_diag "$method" "$obj_path" "$attempt" "HTTP $http_code"
        if [ "$attempt" -lt "$MAX_ATTEMPTS" ] && is_retryable_http_status "$http_code" \
          && backoff_or_give_up "$attempt" "$deadline"; then
          attempt=$((attempt + 1))
          continue
        fi
        echo "ERROR: transfer failed (HTTP $http_code)" >&2
        exit 1
        ;;
    esac
  done
}

# --- Presign, then transfer against the same URL ---
PRESIGN_BODY=$(do_presign "$METHOD" "$MINIO_PATH" "$DECLARED_SIZE")
# The deadline is taken the moment the presign response arrives, not when the
# transfer starts — the clock on the URL's validity has been running since then.
DEADLINE=$(($(date +%s) + 120))

SIGNED_URL=$(printf '%s' "$PRESIGN_BODY" | jq -r '.url')
if [ -z "$SIGNED_URL" ] || [ "$SIGNED_URL" = "null" ]; then
    echo "ERROR: no URL in presign response" >&2
    exit 1
fi

do_transfer "$METHOD" "$SIGNED_URL" "$LOCAL_PATH" "$MINIO_PATH" "$DEADLINE"
