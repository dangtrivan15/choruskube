#!/bin/bash
# artifact — download or upload artifacts via presigned URLs.
#
# Usage:
#   artifact get <object-path> <local-path>   # download from object storage
#   artifact put <local-path> <object-path>   # upload to object storage
#
# Environment:
#   API_SERVER_URL      — Base URL of the ChorusKube API server
#   RUN_ID              — Workflow run UUID
#   NODE_EXECUTION_ID   — Node execution UUID
#   JOB_SECRET          — Bearer token for authentication
#
# Examples:
#   artifact get runs/abc/node1/out/result.md /workspace/in/result.md
#   artifact put /workspace/out/output.md runs/abc/node2/out/output.md
#
# Exit codes:
#   0  Operation completed successfully
#   1  Missing environment, invalid arguments, or transfer error
set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '2,/^set -euo pipefail$/{ /^set -euo pipefail$/d; s/^# \?//; p }' "$0"
    exit 0
fi

# --- Validate args ---
ACTION="${1:-}"
if [ "$ACTION" != "get" ] && [ "$ACTION" != "put" ]; then
    echo "Usage: artifact get <object-path> <local-path>" >&2
    echo "       artifact put <local-path> <object-path>" >&2
    exit 1
fi

if [ -z "${2:-}" ] || [ -z "${3:-}" ]; then
    echo "ERROR: Two arguments required after '$ACTION'." >&2
    exit 1
fi

# --- Validate env ---
if [ -z "${API_SERVER_URL:-}" ]; then
    echo "ERROR: API_SERVER_URL not set. This script must be run inside an agent pod." >&2
    exit 1
fi
if [ -z "${RUN_ID:-}" ] || [ -z "${NODE_EXECUTION_ID:-}" ]; then
    echo "ERROR: RUN_ID and NODE_EXECUTION_ID must be set." >&2
    exit 1
fi
if [ -z "${JOB_SECRET:-}" ]; then
    echo "ERROR: JOB_SECRET not set." >&2
    exit 1
fi

# --- Resolve args based on action ---
if [ "$ACTION" = "get" ]; then
    MINIO_PATH="$2"
    LOCAL_PATH="$3"
    METHOD="GET"
else
    LOCAL_PATH="$2"
    MINIO_PATH="$3"
    METHOD="PUT"
fi

# --- Get presigned URL ---
PRESIGN_URL="$API_SERVER_URL/internal/runs/$RUN_ID/node-executions/$NODE_EXECUTION_ID/presign"
RESPONSE=$(curl -s -w "\n%{http_code}" \
    -H "Authorization: Bearer $JOB_SECRET" \
    "$PRESIGN_URL?path=$(printf '%s' "$MINIO_PATH" | jq -sRr @uri)&method=$METHOD")
HTTP_CODE=$(echo "$RESPONSE" | tail -1)
BODY=$(echo "$RESPONSE" | sed '$d')

if [ "$HTTP_CODE" != "200" ]; then
    echo "ERROR: Presign request failed (HTTP $HTTP_CODE): $BODY" >&2
    exit 1
fi

SIGNED_URL=$(echo "$BODY" | jq -r '.url')
if [ -z "$SIGNED_URL" ] || [ "$SIGNED_URL" = "null" ]; then
    echo "ERROR: No URL in presign response: $BODY" >&2
    exit 1
fi

# --- Execute transfer ---
if [ "$ACTION" = "get" ]; then
    # Ensure parent directory exists
    mkdir -p "$(dirname "$LOCAL_PATH")"
    curl -fsSL "$SIGNED_URL" -o "$LOCAL_PATH"
else
    curl -fsSL -X PUT -T "$LOCAL_PATH" "$SIGNED_URL"
fi
