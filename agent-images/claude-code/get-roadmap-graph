#!/bin/bash
# get-roadmap-graph — fetch an Epic's full Roadmap Graph View via the ChorusKube API server.
#
# Usage: get-roadmap-graph --epic-id UUID
#
# Returns the Epic's entire Story/Task subtree in one call: every Story and
# Task under the Epic, their dependency edges (plus references to blockers
# outside the Epic), a computed "readiness" (READY/BLOCKED) per Story/Task
# derived from its direct dependency edges, and — for each Task — its most
# recent runs (capped) plus a total run count. This is the same response
# shape and data the web UI's Roadmap Graph View renders; agents get it
# through this /internal/ mirror instead of the UI's /api/v1/ route.
#
# Options:
#   --epic-id UUID    Epic UUID to fetch the graph for. Optional — when
#                      omitted, the server resolves it from this run's
#                      triggering Task (its Story's Epic), so a task-triggered
#                      run needs no flags at all, even if this pod's own
#                      client-side $EPIC_ID export never resolved. The $EPIC_ID
#                      env var is no longer consulted directly by this script
#                      (still exported by entrypoint.sh for prompt narration
#                      and other tools).
#   -h, --help        Show this help message
#
# Environment:
#   API_SERVER_URL      — Base URL of the ChorusKube API server
#   RUN_ID              — Workflow run UUID
#   NODE_EXECUTION_ID   — Node execution UUID
#   JOB_SECRET          — Bearer token for authentication
#
# Examples:
#   # Print the full graph as JSON
#   get-roadmap-graph --epic-id <uuid>
#
#   # List Task ids that are READY to start
#   get-roadmap-graph --epic-id <uuid> | jq '.tasks[] | select(.readiness == "READY") | .id'
#
#   # Show each Task's most recent run status
#   get-roadmap-graph --epic-id <uuid> | jq '.tasks[] | {id, title, latestRunStatus}'
#
#   # Task-triggered run: --epic-id omitted, server resolves it from this
#   # run's triggering Task
#   get-roadmap-graph
#
# Exit codes:
#   0  Graph fetched successfully (JSON object printed to stdout)
#   1  Missing arguments, environment, or API error
set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '2,/^set -euo pipefail$/{ /^set -euo pipefail$/d; s/^# \?//; p }' "$0"
    exit 0
fi

if [ -z "${API_SERVER_URL:-}" ]; then
    echo "ERROR: API_SERVER_URL not set. This script must be run inside an agent pod." >&2
    exit 1
fi

if [ -z "${RUN_ID:-}" ] || [ -z "${NODE_EXECUTION_ID:-}" ]; then
    echo "ERROR: RUN_ID and NODE_EXECUTION_ID must be set." >&2
    exit 1
fi

EPIC_ID_ARG=""

while [ $# -gt 0 ]; do
    case "$1" in
        --epic-id)
            EPIC_ID_ARG="$2"
            shift 2
            ;;
        *)
            echo "ERROR: Unknown argument: $1" >&2
            echo "Usage: get-roadmap-graph --epic-id UUID" >&2
            exit 1
            ;;
    esac
done

# When --epic-id is passed explicitly, hit the existing Epic-ID route
# unchanged. Otherwise, call the new no-Epic-ID route (Decision 1, Decision
# 2): the server resolves the Epic from this run's own triggering Task at
# request time, so there's no client-side default to fall back on here at
# all — a manually-started run, or a task-triggered run whose Task's
# Story/Epic link is broken, simply gets a 404 from the server instead of a
# client-side hard failure.
if [ -n "$EPIC_ID_ARG" ]; then
    GRAPH_URL="$API_SERVER_URL/internal/runs/$RUN_ID/node-executions/$NODE_EXECUTION_ID/feature-proposals/$EPIC_ID_ARG/graph"
else
    GRAPH_URL="$API_SERVER_URL/internal/runs/$RUN_ID/node-executions/$NODE_EXECUTION_ID/graph"
fi

RESPONSE=$(curl -s -w "\n%{http_code}" \
    -H "Authorization: Bearer ${JOB_SECRET:-}" \
    "$GRAPH_URL")
HTTP_CODE=$(echo "$RESPONSE" | tail -1)
BODY=$(echo "$RESPONSE" | sed '$d')

if [ "$HTTP_CODE" != "200" ]; then
    echo "ERROR: Failed to fetch Roadmap Graph View (HTTP $HTTP_CODE): $BODY" >&2
    exit 1
fi

echo "$BODY"
