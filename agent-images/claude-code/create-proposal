#!/bin/bash
# create-proposal — create a roadmap Epic via the ChorusKube API server.
#
# Usage: create-proposal --title TITLE --description DESC [--motivation MOT] [--priority LEVEL]
#
# Creates a new Epic targeting the workflow run's software project. The target
# is resolved server-side from the run's software_project_id input; agents
# cannot pick a different target.
#
# This script keeps its original name and internal-endpoint path for backward
# compatibility with deployed agent images (rolling-upgrade safety) even though
# it now operates on Epics, the top level of the Epic -> Story -> Task work
# hierarchy, rather than the old flat feature-proposal model. An Epic created
# here is not yet startable on its own — chain create-story and create-task
# afterwards to produce a startable Task.
#
# Options:
#   --title TITLE         Epic title (required, max 255 chars)
#   --description DESC    Epic description (required)
#   --motivation MOT      Motivation / rationale (optional)
#   --priority LEVEL      Initial priority: low | medium | high (optional,
#                         defaults to medium server-side)
#   -h, --help            Show this help message
#
# Environment:
#   API_SERVER_URL      — Base URL of the ChorusKube API server
#   RUN_ID              — Workflow run UUID
#   NODE_EXECUTION_ID   — Node execution UUID
#   JOB_SECRET          — Bearer token for authentication
#
# Examples:
#   create-proposal --title "Add dark mode" --description "Users want dark mode"
#   create-proposal --title "Add push notifications" --description "..." \
#                   --motivation "Increase engagement" --priority high
#
# Exit codes:
#   0  Epic created successfully (JSON response printed to stdout)
#   1  Missing arguments, environment, or API error
set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '2,/^set -euo pipefail$/{ /^set -euo pipefail$/d; s/^# \?//; p }' "$0"
    exit 0
fi

if [ -z "${API_SERVER_URL:-}" ]; then
    echo "ERROR: API_SERVER_URL not set. This script must be run inside an agent pod." >&2
    exit 1
fi

if [ -z "${RUN_ID:-}" ] || [ -z "${NODE_EXECUTION_ID:-}" ]; then
    echo "ERROR: RUN_ID and NODE_EXECUTION_ID must be set." >&2
    exit 1
fi

TITLE=""
DESCRIPTION=""
MOTIVATION=""
PRIORITY=""

while [ $# -gt 0 ]; do
    case "$1" in
        --title)
            TITLE="$2"
            shift 2
            ;;
        --description)
            DESCRIPTION="$2"
            shift 2
            ;;
        --motivation)
            MOTIVATION="$2"
            shift 2
            ;;
        --priority)
            PRIORITY="$2"
            shift 2
            ;;
        *)
            echo "ERROR: Unknown argument: $1" >&2
            echo "Usage: create-proposal --title TITLE --description DESC [--motivation MOT] [--priority LEVEL]" >&2
            exit 1
            ;;
    esac
done

if [ -z "$TITLE" ] || [ -z "$DESCRIPTION" ]; then
    echo "ERROR: --title and --description are required." >&2
    echo "Usage: create-proposal --title TITLE --description DESC [--motivation MOT] [--priority LEVEL]" >&2
    exit 1
fi

# Build JSON body using jq for proper escaping. The server resolves the Epic's
# software project from the run's inputs — there's no per-Epic override.
# --priority is sent through unvalidated; the server rejects an unknown level
# with 400, surfaced by the generic non-2xx handling below.
BODY=$(jq -n \
    --arg title "$TITLE" \
    --arg description "$DESCRIPTION" \
    --arg motivation "$MOTIVATION" \
    --arg priority "$PRIORITY" \
    '{title: $title, description: $description}
        + (if $motivation != "" then {motivation: $motivation} else {} end)
        + (if $priority != "" then {priority: $priority} else {} end)')

RESPONSE=$(curl -s -w "\n%{http_code}" -X POST \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer ${JOB_SECRET:-}" \
    -d "$BODY" \
    "$API_SERVER_URL/internal/runs/$RUN_ID/node-executions/$NODE_EXECUTION_ID/feature-proposals")
HTTP_CODE=$(echo "$RESPONSE" | tail -1)
BODY_RESPONSE=$(echo "$RESPONSE" | sed '$d')

if [ "$HTTP_CODE" != "201" ]; then
    echo "ERROR: Failed to create Epic (HTTP $HTTP_CODE): $BODY_RESPONSE" >&2
    exit 1
fi

echo "$BODY_RESPONSE"
