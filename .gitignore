# Local-only design specs and implementation plans — never committed.
# Kept on disk for reference but excluded from the (soon-public) repo history.
docs/superpowers/

# IntelliJ IDEA project metadata
.idea/

# Local secrets — written by scripts/setup.sh, never committed.
.env
.secrets/

# Per-developer Claude Code settings. Shared agent config under .claude/ is committed.
.claude/settings.local.json

# Root Gradle build state. Anchored with a leading slash so it only covers the aggregator
# build's own output (the timing report lands in /build) — each component keeps its own rule.
/.gradle/
/build/
.project
.settings
